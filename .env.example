HASHMARGIN_ACCOUNTS_ENABLED=false
# Restrict beta accounts while provider end-to-end tests are in progress.
HASHMARGIN_ACCOUNT_TEST_EMAILS=
HASHMARGIN_BILLING_MODE=disabled
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only sk_test_ keys are accepted. Live and restricted keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
